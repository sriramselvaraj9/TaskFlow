# NEXTAUTH CONFIGURATION
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=taskflow-monochrome-super-secret-key-2026

# OPTION 1: BREVO (SENDINBLUE) CONFIGURATION (Recommended for Real Email Delivery)
# 1. Sign up / log in at https://app.brevo.com
# 2. Go to Transactional > Settings > SMTP & API
# 3. Generate a new API Key (xkeysib-...) or SMTP Key (xsmtpsib-...)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_USER=your_verified_brevo_email@domain.com
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_KEY=xsmtpsib-your_brevo_smtp_key_here
BREVO_FROM="TaskFlow Workspace" <your_verified_brevo_email@domain.com>

# OPTION 2: GMAIL SMTP CONFIGURATION (Alternative)
# Create a 16-character Google App Password at: https://myaccount.google.com/apppasswords
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASS=your_16_char_google_app_password

# OPTION 3: CUSTOM / CORPORATE SMTP (Alternative)
# SMTP_HOST=smtp.yourserver.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@domain.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM="TaskFlow Security" <your_email@domain.com>