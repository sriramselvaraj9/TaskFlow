# Application Telemetry & Environment
APP_NAME=TaskFlow
APP_VERSION=0.1.1
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Frontend Canonical URL
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3002

# PostgreSQL Database Configuration (Global Docker DB: mydb)
# For Host Local Development (uvicorn directly on Windows):
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=mydb
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/mydb

# For Docker Containers (Connecting to Global DB):
# POSTGRES_SERVER=postgres_db
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@postgres_db:5432/mydb

# Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=True
DB_ECHO=False
DB_EXPIRE_ON_COMMIT=False

# JWT Security & Token Lifecycles
JWT_SECRET=taskflow-super-secure-production-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
INVITE_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# Redis Cache & Sessions (Global Docker Redis: redis_db)
# For Host Local Development:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# For Docker Containers:
# REDIS_HOST=host.docker.internal
# REDIS_PORT=6379
# REDIS_URL=redis://host.docker.internal:6379/0

# Email Delivery Configuration (Brevo SMTP / REST API)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_USER=your_verified_sender@domain.com
BREVO_FROM="TaskFlow Admin" <your_verified_sender@domain.com>

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_verified_sender@domain.com
BREVO_SMTP_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@domain.com

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="TaskFlow Admin" <your_verified_sender@domain.com>
SMTP_SECURE=False
